# Database (PostgreSQL recommended; SQLite fallback for local test)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edututor

# Qdrant Vector Store (empty for embedded local storage at ./qdrant_data)
QDRANT_URL=

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Authentication Secret (min 32 characters for HMAC-SHA256)
JWT_SECRET=replace-with-a-secure-random-secret-key-32chars

# Media Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
